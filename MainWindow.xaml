<Window x:Class="ClipViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipViewer v0.8.11"
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        Cursor="None"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        MouseWheel="Window_MouseWheel"
        MouseLeave="Window_MouseLeave">
    <!-- RootGrid = クライアント領域基準。シークバー出現判定はウィンドウ枠込みの
         Window.ActualHeight ではなくこちらの高さで行う（v0.8.8） -->
    <Grid x:Name="RootGrid">

        <!-- ズーム・ドラッグ用コンテナ（Transform をここに適用） -->
        <Grid x:Name="ZoomContainer">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform     x:Name="ZoomScale"     ScaleX="1" ScaleY="1" CenterX="0" CenterY="0" />
                    <TranslateTransform x:Name="ZoomTranslate" X="0"      Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 回転・反転用コンテナ -->
            <Grid x:Name="ImageTransformContainer"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <!-- 回転時FIT補正: 90/270°時に回転後の縦横でフィットさせる倍率（v0.8.3） -->
                        <ScaleTransform  x:Name="RotateFitScale" ScaleX="1" ScaleY="1"/>
                        <ScaleTransform  x:Name="FlipScale"   ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="ImageRotate" Angle="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- 単ページ表示 -->
                <Image x:Name="SingleImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="Fant"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       SizeChanged="SingleImage_SizeChanged"
                       Visibility="Visible" />

                <!-- 見開き表示: 2画像を密接横並び -->
                <Grid x:Name="SpreadGrid"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左ページ -->
                    <Image x:Name="LeftImage"
                           Grid.Column="0"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="Fant"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />

                    <!-- 右ページ -->
                    <Image x:Name="RightImage"
                           Grid.Column="1"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="Fant"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <!-- 情報表示 + 操作通知パネル（右上・右25%エリア） -->
        <StackPanel x:Name="InfoStackPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,12,0">

            <!-- F1/Tab 情報表示 -->
            <Border x:Name="InfoPanel"
                    Padding="8,4"
                    Background="#99000000"
                    CornerRadius="3"
                    Visibility="Collapsed">
                <StackPanel>
                    <!-- Basic 情報（長いファイル名等はエリア内で折り返す） -->
                    <TextBlock x:Name="InfoFileName"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="InfoPageNumber"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="InfoZoom"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap" />
                    <!-- アニメ再生フレーム番号（アニメ表示中のみ、v0.8.5） -->
                    <TextBlock x:Name="InfoAnimFrame"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <!-- アニメ再生モード（アニメ表示中は必ず表示、v0.8.8）-->
                    <TextBlock x:Name="InfoAnimMode"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <!-- 一時停止表示（一時停止中のみ、v0.8.8）-->
                    <TextBlock x:Name="InfoAnimPause"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <!-- 回転・反転ステータス（変換中のみ表示、v0.8.5） -->
                    <TextBlock x:Name="InfoTransform"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <!-- Detailed 情報（Detailed モード時のみ表示） -->
                    <TextBlock x:Name="InfoPixelSize"
                               Foreground="#FFBBBBBB"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="InfoFullPath"
                               Foreground="#FFBBBBBB"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="InfoExif"
                               Foreground="#FFBBBBBB"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 操作エラー通知（自動消去） -->
            <Border x:Name="NotifyPanel"
                    Margin="0,4,0,0"
                    Padding="8,4"
                    Background="#CC880000"
                    CornerRadius="3"
                    Visibility="Collapsed">
                <TextBlock x:Name="NotifyText"
                           Foreground="White"
                           FontSize="13"
                           FontFamily="Segoe UI"
                           TextWrapping="Wrap" />
            </Border>

        </StackPanel>

        <!-- シークバー（画面下端ホバーで表示、F51）
             読了部分=ビビッドイエロー（15%透過）/ 未読部分=レッド（不透明度15%）+黒1px縁取り。
             右綴じ時は右起点で埋まる（v0.8.7で配色変更、v0.8.10で未読部分に下地を追加） -->
        <Grid x:Name="SeekBarPanel"
              VerticalAlignment="Bottom"
              Height="50"
              Background="Transparent"
              Opacity="0"
              IsHitTestVisible="False"
              MouseLeftButtonDown="SeekBar_MouseLeftButtonDown"
              MouseMove="SeekBar_MouseMove"
              MouseLeftButtonUp="SeekBar_MouseLeftButtonUp">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ドラッグ中のページ番号（サムの真上に追従） -->
            <TextBlock x:Name="SeekPageLabel"
                       Grid.Column="1"
                       Foreground="#FFE600"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,6,0,0"
                       Visibility="Collapsed">
                <!-- 黄文字は明るい画像上で溶けるため黒シャドウで縁取り相当を付ける（v0.8.7） -->
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="1" />
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SeekLabelPos" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- トラック（バー8px・中央80%幅）
                 v0.8.7: バー=ビビッドイエロー #FFE600 の15%透過(α=D9)+黒1px縁取り（縁は不透過）。
                 サム16px+黒1px縁・塗りは非透過100%イエロー（透けると体裁が悪いため）
                 v0.8.10: 未読部分の下地に少しオレンジ寄りのレッド #FF3300 を不透明度15%（α=26）で追加
                 （黒背景では輪郭線だけだとバーが消えて見えなくなるため。あくまで
                 「うっすら色が乗る」濃度で、下の画像はほぼ透けたままにする）。
                 z順は 未読下地→読了塗り→輪郭→サム（黒縁と読了塗りを潰さない順） -->
            <Grid x:Name="SeekTrack"
                  Grid.Column="1"
                  Height="20"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,10"
                  SizeChanged="SeekTrack_SizeChanged">
                <Rectangle x:Name="SeekUnread"
                           Height="8" VerticalAlignment="Center"
                           Fill="#26FF3300"
                           RadiusX="4" RadiusY="4" />
                <Rectangle x:Name="SeekFill"
                           Height="8" VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Fill="#D9FFE600"
                           RadiusX="4" RadiusY="4"
                           Width="0" />
                <Rectangle x:Name="SeekOutline"
                           Height="8" VerticalAlignment="Center"
                           Stroke="#FF000000" StrokeThickness="1"
                           Fill="Transparent"
                           RadiusX="4" RadiusY="4" />
                <Ellipse x:Name="SeekThumb"
                         Width="16" Height="16"
                         Fill="#FFFFE600"
                         Stroke="#FF000000" StrokeThickness="1"
                         HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SeekThumbPos" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Grid>

        <!-- エラー・案内テキスト（常に最前面） -->
        <TextBlock x:Name="ErrorText"
                   Foreground="White"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="40" />

    </Grid>
</Window>
