<Window x:Class="ClipViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipViewer v0.8.2"
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        Cursor="None"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        MouseWheel="Window_MouseWheel"
        MouseLeave="Window_MouseLeave">
    <Grid>

        <!-- ズーム・ドラッグ用コンテナ（Transform をここに適用） -->
        <Grid x:Name="ZoomContainer">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform     x:Name="ZoomScale"     ScaleX="1" ScaleY="1" CenterX="0" CenterY="0" />
                    <TranslateTransform x:Name="ZoomTranslate" X="0"      Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 回転・反転用コンテナ -->
            <Grid x:Name="ImageTransformContainer"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform  x:Name="FlipScale"   ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="ImageRotate" Angle="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- 単ページ表示 -->
                <Image x:Name="SingleImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="Fant"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Visible" />

                <!-- 見開き表示: 2画像を密接横並び -->
                <Grid x:Name="SpreadGrid"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左ページ -->
                    <Image x:Name="LeftImage"
                           Grid.Column="0"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="Fant"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />

                    <!-- 右ページ -->
                    <Image x:Name="RightImage"
                           Grid.Column="1"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="Fant"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <!-- 情報表示 + 操作通知パネル（右上・右25%エリア） -->
        <StackPanel x:Name="InfoStackPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,12,0">

            <!-- F1/Tab 情報表示 -->
            <Border x:Name="InfoPanel"
                    Padding="8,4"
                    Background="#99000000"
                    CornerRadius="3"
                    Visibility="Collapsed">
                <StackPanel>
                    <!-- Basic 情報（長いファイル名等はエリア内で折り返す） -->
                    <TextBlock x:Name="InfoFileName"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="InfoPageNumber"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="InfoZoom"
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap" />
                    <!-- Detailed 情報（Detailed モード時のみ表示） -->
                    <TextBlock x:Name="InfoPixelSize"
                               Foreground="#FFBBBBBB"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="InfoFullPath"
                               Foreground="#FFBBBBBB"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="InfoExif"
                               Foreground="#FFBBBBBB"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 操作エラー通知（自動消去） -->
            <Border x:Name="NotifyPanel"
                    Margin="0,4,0,0"
                    Padding="8,4"
                    Background="#CC880000"
                    CornerRadius="3"
                    Visibility="Collapsed">
                <TextBlock x:Name="NotifyText"
                           Foreground="White"
                           FontSize="13"
                           FontFamily="Segoe UI"
                           TextWrapping="Wrap" />
            </Border>

        </StackPanel>

        <!-- シークバー（画面下端ホバーで表示、F51）
             読了部分=オレンジ塗り / 未読部分=1px輪郭のみ。右綴じ時は右起点で埋まる -->
        <Grid x:Name="SeekBarPanel"
              VerticalAlignment="Bottom"
              Height="48"
              Background="Transparent"
              Opacity="0"
              IsHitTestVisible="False"
              MouseLeftButtonDown="SeekBar_MouseLeftButtonDown"
              MouseMove="SeekBar_MouseMove"
              MouseLeftButtonUp="SeekBar_MouseLeftButtonUp">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ドラッグ中のページ番号（サムの真上に追従） -->
            <TextBlock x:Name="SeekPageLabel"
                       Grid.Column="1"
                       Foreground="#FF9500"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,6,0,0"
                       Visibility="Collapsed">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SeekLabelPos" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- トラック（バー8px・中央80%幅） -->
            <Grid x:Name="SeekTrack"
                  Grid.Column="1"
                  Height="14"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,10"
                  SizeChanged="SeekTrack_SizeChanged">
                <Rectangle x:Name="SeekOutline"
                           Height="8" VerticalAlignment="Center"
                           Stroke="#FF9500" StrokeThickness="1"
                           Fill="Transparent"
                           RadiusX="4" RadiusY="4" />
                <Rectangle x:Name="SeekFill"
                           Height="8" VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Fill="#FF9500"
                           RadiusX="4" RadiusY="4"
                           Width="0" />
                <Ellipse x:Name="SeekThumb"
                         Width="14" Height="14"
                         Fill="#FF9500"
                         HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SeekThumbPos" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Grid>

        <!-- エラー・案内テキスト（常に最前面） -->
        <TextBlock x:Name="ErrorText"
                   Foreground="White"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="40" />

    </Grid>
</Window>
